#!/usr/bin/env sh

set -eu

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

filter_files() {
    pattern=$1

    if command -v rg >/dev/null 2>&1; then
        printf '%s\n' "$STAGED_FILES" | rg "$pattern" || true
    else
        printf '%s\n' "$STAGED_FILES" | grep -E "$pattern" || true
    fi
}

PHP_FILES=$(filter_files '\.php$')
BIOME_FILES=$(filter_files '\.(js|jsx|ts|tsx|json|jsonc|css)$')

if [ -n "$PHP_FILES" ]; then
    if command -v cmd.exe >/dev/null 2>&1; then
        PINT_COMMAND="cmd.exe /c vendor\\bin\\pint.bat"
    elif command -v php >/dev/null 2>&1; then
        PINT_COMMAND="php vendor/bin/pint"
    else
        echo "pre-commit: php is not available."
        exit 1
    fi

    echo "Running Pint on staged PHP files..."
    $PINT_COMMAND $PHP_FILES
    git add $PHP_FILES
fi

if [ -n "$BIOME_FILES" ]; then
    if ! command -v pnpm >/dev/null 2>&1; then
        echo "pre-commit: pnpm is not installed."
        exit 1
    fi

    echo "Running Biome on staged frontend files..."
    pnpm biome check --write $BIOME_FILES
    git add $BIOME_FILES
fi

if ! command -v pnpm >/dev/null 2>&1; then
    echo "pre-commit: pnpm is not installed."
    exit 1
fi

echo "Running Biome lint..."
pnpm lint
git add $STAGED_FILES
