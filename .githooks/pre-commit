#!/usr/bin/env sh

set -eu

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

filter_files() {
    pattern=$1

    if command -v rg >/dev/null 2>&1; then
        printf '%s\n' "$STAGED_FILES" | rg "$pattern" || true
    else
        printf '%s\n' "$STAGED_FILES" | grep -E "$pattern" || true
    fi
}

PHP_FILES=$(filter_files '\.php$')
PRETTIER_FILES=$(filter_files '\.(js|jsx|ts|tsx|json|md|css|scss|html|yml|yaml)$')

if [ -n "$PHP_FILES" ]; then
    echo "Running Pint on staged PHP files..."
    vendor/bin/pint $PHP_FILES
    git add $PHP_FILES
fi

if [ -n "$PRETTIER_FILES" ]; then
    echo "Running Prettier on staged frontend files..."
    pnpm prettier --write $PRETTIER_FILES
    git add $PRETTIER_FILES
fi
